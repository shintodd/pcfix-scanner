<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.4.0" name="PcfixScanner.app"/>

  <!--
    Runs standard user privilege by default (asInvoker) - no UAC prompt on launch.

    Trade-off: root\Microsoft\Windows\Storage (real SMART/reliability data) and
    BitLocker status only return real values to an elevated process. Without
    admin, PopulateSmartHealth() logs a WARN and every disk reports as "SMART
    Unavailable" rather than a fake "healthy" - honest, but not the real data.
    Real drive health (MSFT_PhysicalDisk / MSFT_StorageReliabilityCounter under
    root\Microsoft\Windows\Storage) returns data if elevated. If run non-elevated,
    PopulateSmartHealth() logs a WARN and reports SMART as Unavailable instead
    of crashing or failing launch.
  -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
